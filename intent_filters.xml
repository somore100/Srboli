<!-- Added to Srboli's main activity by buildozer (android.manifest.intent_filters).
     "Open with" for text, images, video, PDFs and zips; "Share" for text and files. -->
<intent-filter>
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <data android:scheme="content" />
    <data android:scheme="file" />
    <data android:mimeType="text/*" />
    <data android:mimeType="image/*" />
    <data android:mimeType="video/*" />
    <data android:mimeType="application/pdf" />
    <data android:mimeType="application/zip" />
    <data android:mimeType="application/json" />
</intent-filter>
<intent-filter>
    <action android:name="android.intent.action.SEND" />
    <category android:name="android.intent.category.DEFAULT" />
    <data android:mimeType="text/*" />
    <data android:mimeType="image/*" />
    <data android:mimeType="audio/*" />
    <data android:mimeType="application/pdf" />
    <data android:mimeType="application/zip" />
</intent-filter>
<!-- The main activity is closed here on purpose: the template's own closing tag
     ends the overlay-player activity below instead. Sounds opened with Srboli
     go to the small overlay player (java/org/somore100/srboli). -->
</activity>
<service android:name="org.somore100.srboli.PlayerService"
    android:exported="false"
    android:foregroundServiceType="mediaPlayback" />
<activity android:name="org.somore100.srboli.MiniPlayerActivity"
    android:theme="@android:style/Theme.Translucent.NoTitleBar"
    android:exported="true"
    android:launchMode="singleTask"
    android:taskAffinity=""
    android:excludeFromRecents="true">
<intent-filter>
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <data android:scheme="content" />
    <data android:scheme="file" />
    <data android:mimeType="audio/*" />
</intent-filter>
